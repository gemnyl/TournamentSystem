# ─── Django ──────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=replace-me-with-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost 127.0.0.1

# ─── База даних (PostgreSQL) ──────────────────────────────────────────────────
DB_NAME=tournament_db
DB_USER=tournament_user
DB_PASSWORD=tournament_pass
DB_HOST=localhost
DB_PORT=5432

# ─── Redis (Django Channels) ──────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── CORS (Vite dev-server) ───────────────────────────────────────────────────
CORS_ALLOWED_ORIGINS=http://localhost:5173 http://127.0.0.1:5173
# Monobank Acquiring
MONOBANK_TOKEN=your-mono-token
MONOBANK_USE_SANDBOX=True
MONOBANK_MOCK_PAYMENTS=True
