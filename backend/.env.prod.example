# ─────────────────────────────────────────────────────────────────────────────
# .env.prod.example — шаблон продакшен-конфігурації.
#
# Скопіюйте цей файл на VM як ~/app/.env (саме .env — його читає docker compose
# і для підстановки змінних, і як env_file для backend) та заповніть значення.
# НЕ комітьте справжній .env у репозиторій.
# ─────────────────────────────────────────────────────────────────────────────

# ── Django ───────────────────────────────────────────────────────────────────
DJANGO_SECRET_KEY=замініть-на-довгий-випадковий-рядок-50+-символів
DJANGO_DEBUG=False
# Azure FQDN, напр. tournament-master.germanywestcentral.cloudapp.azure.com
DJANGO_ALLOWED_HOSTS=your-label.germanywestcentral.cloudapp.azure.com

# ── База даних (внутрішня мережа compose) ────────────────────────────────────
DB_NAME=tournament_db
DB_USER=tournament_user
DB_PASSWORD=замініть-на-надійний-пароль-БД

# ── TLS / домен (використовує Caddy) ─────────────────────────────────────────
DOMAIN=your-label.germanywestcentral.cloudapp.azure.com
ACME_EMAIL=you@example.com

# ── Образи з GHCR (змініть власника, якщо форк) ───────────────────────────────
IMAGE_BACKEND=ghcr.io/gemnyl/tournament-backend:latest
IMAGE_FRONTEND=ghcr.io/gemnyl/tournament-frontend:latest

# ── Monobank (за замовчуванням mock — без реальних списань) ───────────────────
MONOBANK_MOCK_PAYMENTS=True
MONOBANK_USE_SANDBOX=True
MONOBANK_TOKEN=

# ── Тротлінг автентифікації (опційно) ─────────────────────────────────────────
AUTH_THROTTLE_RATE=5/minute

# ── HTTPS-захист (опційно) ────────────────────────────────────────────────────
# Увімкніть HSTS лише коли впевнені, що домен назавжди на HTTPS:
# SECURE_HSTS_SECONDS=31536000
